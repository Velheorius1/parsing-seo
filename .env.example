# parsing-seo — root .env reference
#
# Production .env files live in:
#   /opt/parsing-seo/.env           — crawler runtime (server-side)
#   /opt/parsing-seo/.env.cooperation — cooperation.uz proxy fetcher
#   web/.env.local                   — frontend (Vercel uses Project env vars)
#
# This file is a CONSOLIDATED REFERENCE. Copy specific sections to the correct
# .env file. NEVER commit real values to git.

# ─── Supabase (shared) ────────────────────────────────────────
SUPABASE_URL=https://oaoehczbycrabkprazts.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # crawler/.env, write access (rotate ~6 month)
NEXT_PUBLIC_SUPABASE_URL=           # web/.env.local
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # web/.env.local, read-only

# ─── Crawler (server-side) ────────────────────────────────────
OPENROUTER_API_KEY=                 # AI relevance / enrichment (Qwen3)
AI_RELEVANCE_MODEL=qwen/qwen3-30b-a3b
TELEGRAM_BOT_TOKEN=                 # Tender alerts bot
TELEGRAM_ALERT_CHAT_ID=             # Where to send alerts
TELEGRAM_API_ID=                    # Telethon — for telegram_adapter.py
TELEGRAM_API_HASH=
TELEGRAM_SESSION=crawler_session
DRY_RUN=false
LOG_LEVEL=INFO
BATCH_SIZE=500
COMPETITOR_KEYWORDS=                # comma-separated
LEAD_GEN_ENABLED=true

# ─── cooperation.uz proxy ─────────────────────────────────────
COOPERATION_PROXY_URL=https://parsing-seo.vercel.app/api/proxy/cooperation
PROXY_SECRET=                       # shared between crawler ↔ Vercel proxy

# ─── Frontend extras (web/.env.local) ─────────────────────────
APIFY_API_TOKEN=                    # web/.env.local
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SERPAPI_KEY=
SERPER_API_KEY=
ADMIN_SECRET_TOKEN=
NEXT_PUBLIC_ADMIN_SECRET_TOKEN=
